{
  "id": "portal/portal_transfer_filters",
  "name": "PORTAL_TRANSFER_001",
  "display_name": "债权转让、体验标与筛选枚举只读校验",
  "description": "免登录只读：债权转让筛选枚举与可购买列表（允许 0 条）、体验标列表（允许 0 条）、投资列表筛选枚举。仅校验 HTTP 与响应字段存在。",
  "category": "portal",
  "module": "portal",
  "priority": "P1",
