{
  "id": "smoke/back_site",
  "name": "SMOKE_BACK_001",
  "display_name": "后台站点冒烟（8082：登录页/验证码/管理员登录接口）",
  "description": "纯 HTTP 冒烟：验证运营后台登录页可达、登录图形验证码可签发（会话级）、管理员账号密码图形码三要素登录成功。全程不启动浏览器，秒级完成。",
  "category": "smoke",
  "module": "admin",
  "priority": "P0",
  "expected": "登录页 HTTP 200 且为帝友后台；验证码 200 且字节>=1000；管理员登录业务码 200、消息 OK",
  "nodes": [
    {
      "id": "get_login_page",
      "type": "step",
      "step_id": "step_probe_http_get",
      "label": "探测后台登录页",
      "params": {"path": "/", "site": "back"}
    },
    {
      "id": "check_page_status",
      "type": "check",
      "check_id": "check_probe_http_status",
      "label": "登录页 200",
      "params": {"http_status": "${get_login_page.data.http_status}", "expected": 200}
    },
    {
      "id": "check_page_marker",
      "type": "check",
      "check_id": "check_probe_content_contains",
      "label": "登录页为帝友后台",
      "params": {"body_text": "${get_login_page.data.body_text}", "expected": "帝友系统后台"}
    },
    {
      "id": "get_code",
      "type": "step",
      "step_id": "step_backend_api_get_verifycode",
      "label": "获取后台登录验证码",
      "params": {}
    },
    {
      "id": "check_code_status",
      "type": "check",
      "check_id": "check_backend_api_verifycode_size",
      "label": "验证码为非空图片",
      "params": {"body_length": "${get_code.data.body_length}", "min_length": 1000}
    },
    {
      "id": "step_admin_login",
      "type": "step",
      "step_id": "step_backend_api_login",
      "label": "管理员 HTTP 登录",
      "params": {"username": "admin", "password": "HM_2023_test", "valicode": "8888", "fetch_code": true}
    },
    {
      "id": "check_login_code",
      "type": "check",
      "check_id": "check_backend_api_business_code",
      "label": "登录业务码 200",
      "params": {"code": "${step_admin_login.data.code}", "expected": 200}
    },
    {
      "id": "check_login_msg",
      "type": "check",
      "check_id": "check_backend_api_message_contains",
      "label": "登录消息 OK",
      "params": {"message": "${step_admin_login.data.message}", "expected": "OK"}
    }
  ],
  "edges": [
    {"source": "get_login_page", "target": "check_page_status", "condition": "pass"},
    {"source": "check_page_status", "target": "check_page_marker", "condition": "pass"},
    {"source": "check_page_marker", "target": "get_code", "condition": "pass"},
    {"source": "get_code", "target": "check_code_status", "condition": "pass"},
    {"source": "check_code_status", "target": "step_admin_login", "condition": "pass"},
    {"source": "step_admin_login", "target": "check_login_code", "condition": "pass"},
    {"source": "check_login_code", "target": "check_login_msg", "condition": "pass"}
  ],
  "metadata": {"layer": "smoke", "mode": "http-only", "site": "http://121.43.169.97:8082"}
}
