{
  "id": "ui/ui_register_page",
  "name": "UI_REGISTER_PAGE_001",
  "display_name": "前台注册页界面校验",
  "description": "UI 界面测试：打开前台注册页，校验注册表单要素（手机号/密码/图形验证码/短信验证码/获取验证码按钮）齐全（用户名输入框在模板中被注释，浏览器不渲染，不做存在性断言），并截图存档。只做存在性校验，不触发短信与注册（零数据变更）。",
  "category": "ui",
  "module": "browser",
  "priority": "P1",
  "suites": "ui,regression",
  "nodes": [
    {
      "id": "open_register_page",
      "type": "step",
      "step_id": "step_open_browser_url",
      "label": "打开前台注册页",
      "params": {"url": "http://121.43.169.97:8081/common/member/reg"}
    },
    {
      "id": "check_reg_title",
      "type": "check",
      "check_id": "check_page_title_equal",
      "label": "注册页标题为 传智播客",
      "params": {"expected": "传智播客"}
    },
    {
      "id": "check_phone_input",
      "type": "check",
      "check_id": "check_element_exists",
      "label": "手机号输入框存在",
      "params": {"by": "id", "value": "phone", "timeout": 10}
    },
    {
      "id": "check_password_input",
      "type": "check",
      "check_id": "check_element_exists",
      "label": "密码输入框存在",
      "params": {"by": "id", "value": "password", "timeout": 10}
    },
    {
      "id": "check_verifycode_input",
      "type": "check",
      "check_id": "check_element_exists",
      "label": "图形验证码输入框存在",
      "params": {"by": "id", "value": "verifycode", "timeout": 10}
    },
    {
      "id": "check_phone_code_input",
      "type": "check",
      "check_id": "check_element_exists",
      "label": "短信验证码输入框存在",
      "params": {"by": "id", "value": "phone_code", "timeout": 10}
    },
    {
      "id": "check_get_code_button",
      "type": "check",
      "check_id": "check_element_exists",
      "label": "获取验证码按钮存在",
      "params": {"by": "id", "value": "get_phone_code", "timeout": 10}
    },
    {
      "id": "screenshot_register",
      "type": "step",
      "step_id": "step_capture_screenshot",
      "label": "注册页截图存档",
      "params": {"file_name": "ui_register_page"}
    }
  ],
  "edges": [
    {"source": "open_register_page", "target": "check_reg_title", "condition": "pass"},
    {"source": "check_reg_title", "target": "check_phone_input", "condition": "pass"},
    {"source": "check_phone_input", "target": "check_password_input", "condition": "pass"},
    {"source": "check_password_input", "target": "check_verifycode_input", "condition": "pass"},
    {"source": "check_verifycode_input", "target": "check_phone_code_input", "condition": "pass"},
    {"source": "check_phone_code_input", "target": "check_get_code_button", "condition": "pass"},
    {"source": "check_get_code_button", "target": "screenshot_register", "condition": "pass"}
  ],
  "metadata": {
    "setup_hooks": [
      {"step_id": "step_log_message", "params": {"message": "setup hook: ui register page begin", "level": "info"}}
    ],
    "teardown_hooks": [
      {"step_id": "step_log_message", "params": {"message": "teardown hook: ui register page end", "level": "info"}}
    ]
  }
}
