{
  "id": "ui/ui_login_page",
  "name": "UI_LOGIN_PAGE_001",
  "display_name": "前台登录页界面与输入功能校验",
  "description": "UI 界面测试：打开前台登录页，校验登录表单三要素（账号/密码/登录按钮）齐全（图形验证码由 AngularJS 条件渲染，默认不展示，不做存在性断言），演示输入功能（仅输入不提交，零数据变更），并截图存档。",
  "category": "ui",
  "module": "browser",
  "priority": "P1",
  "suites": "ui,regression",
  "nodes": [
    {
      "id": "open_login_page",
      "type": "step",
      "step_id": "step_open_browser_url",
      "label": "打开前台登录页",
      "params": {"url": "http://121.43.169.97:8081/common/member/login"}
    },
    {
      "id": "check_login_title",
      "type": "check",
      "check_id": "check_page_title_equal",
      "label": "登录页标题为 传智播客",
      "params": {"expected": "传智播客"}
    },
    {
      "id": "check_keywords_input",
      "type": "check",
      "check_id": "check_element_exists",
      "label": "账号输入框存在",
      "params": {"by": "id", "value": "keywords", "timeout": 10}
    },
    {
      "id": "check_password_input",
      "type": "check",
      "check_id": "check_element_exists",
      "label": "密码输入框存在",
      "params": {"by": "id", "value": "password", "timeout": 10}
    },
    {
      "id": "check_login_button",
      "type": "check",
      "check_id": "check_element_exists",
      "label": "立即登录按钮存在",
      "params": {"by": "id", "value": "login-btn", "timeout": 10}
    },
    {
      "id": "input_keywords_demo",
      "type": "step",
      "step_id": "step_input_element_text",
      "label": "输入账号演示（不提交）",
      "params": {"by": "id", "value": "keywords", "text": "18800002008"}
    },
    {
      "id": "input_password_demo",
      "type": "step",
      "step_id": "step_input_element_text",
      "label": "输入密码演示（不提交）",
      "params": {"by": "id", "value": "password", "text": "Aa123456"}
    },
    {
      "id": "screenshot_login",
      "type": "step",
      "step_id": "step_capture_screenshot",
      "label": "登录页截图存档",
      "params": {"file_name": "ui_login_page"}
    }
  ],
  "edges": [
    {"source": "open_login_page", "target": "check_login_title", "condition": "pass"},
    {"source": "check_login_title", "target": "check_keywords_input", "condition": "pass"},
    {"source": "check_keywords_input", "target": "check_password_input", "condition": "pass"},
    {"source": "check_password_input", "target": "check_login_button", "condition": "pass"},
    {"source": "check_login_button", "target": "input_keywords_demo", "condition": "pass"},
    {"source": "input_keywords_demo", "target": "input_password_demo", "condition": "pass"},
    {"source": "input_password_demo", "target": "screenshot_login", "condition": "pass"}
  ],
  "metadata": {
    "setup_hooks": [
      {"step_id": "step_log_message", "params": {"message": "setup hook: ui login page begin", "level": "info"}}
    ],
    "teardown_hooks": [
      {"step_id": "step_log_message", "params": {"message": "teardown hook: ui login page end", "level": "info"}}
    ]
  }
}
