{
  "id": "performance/public_apis",
  "name": "PERF_PUBLIC_001",
  "display_name": "公共只读端点性能基线（首页/投资列表/平台统计）",
  "description": "纯 HTTP 只读压测（零数据副作用）：对前台首页、投资列表、平台统计三个公共端点分别以并发 5、总量 30 瞬时加压，断言全部完成、成功率>=95%、无 5xx、p95<=2000ms、RPS>=5。阈值依据 2026-09-19 真实站点基线（p95 实测 81~194ms、RPS 38~97）预留充足余量，用于版本准入时发现明显性能回退，而非容量极限测试。",
  "category": "performance",
  "module": "site",
  "priority": "P1",
  "expected": "3 个端点各 30 请求全部完成；成功率>=95%；5xx=0；p95<=2000ms；RPS>=5；平台统计业务码 200 占比 100%",
  "nodes": [
    {
      "id": "load_home",
      "type": "step",
      "step_id": "step_load_http",
      "label": "压测前台首页 GET /",
      "params": {"path": "/", "method": "GET", "site": "front", "concurrency": 5, "total_requests": 30}
    },
    {
      "id": "check_home_completed",
      "type": "check",
      "check_id": "check_load_all_completed",
      "label": "首页请求全部完成",
      "params": {"total_requests": "${load_home.data.total_requests}", "completed": "${load_home.data.completed}"}
    },
    {
      "id": "check_home_rate",
      "type": "check",
      "check_id": "check_load_success_rate",
      "label": "首页成功率>=95%",
      "params": {"success_rate": "${load_home.data.success_rate}", "min_rate": 0.95}
    },
    {
      "id": "check_home_5xx",
      "type": "check",
      "check_id": "check_load_no_server_error",
      "label": "首页无5xx",
      "params": {"server_errors": "${load_home.data.server_errors}", "max_count": 0}
    },
    {
      "id": "check_home_p95",
      "type": "check",
      "check_id": "check_load_percentile_ms",
      "label": "首页p95<=2000ms",
      "params": {"percentile_ms": "${load_home.data.p95_ms}", "percentile": "p95", "max_ms": 2000}
    },
    {
      "id": "check_home_rps",
      "type": "check",
      "check_id": "check_load_rps",
      "label": "首页RPS>=5",
      "params": {"rps": "${load_home.data.rps}", "min_rps": 5}
    },
    {
      "id": "load_loan_list",
      "type": "step",
      "step_id": "step_load_http",
      "label": "压测投资列表 POST listtender",
      "params": {
        "path": "/loan/loan/listtender", "method": "POST", "site": "front",
        "data": {"page": 1, "epage": 5},
        "concurrency": 5, "total_requests": 30
      }
    },
    {
      "id": "check_list_completed",
      "type": "check",
      "check_id": "check_load_all_completed",
      "label": "投资列表请求全部完成",
      "params": {"total_requests": "${load_loan_list.data.total_requests}", "completed": "${load_loan_list.data.completed}"}
    },
    {
      "id": "check_list_rate",
      "type": "check",
      "check_id": "check_load_success_rate",
      "label": "投资列表成功率>=95%",
      "params": {"success_rate": "${load_loan_list.data.success_rate}", "min_rate": 0.95}
    },
    {
      "id": "check_list_5xx",
      "type": "check",
      "check_id": "check_load_no_server_error",
      "label": "投资列表无5xx",
      "params": {"server_errors": "${load_loan_list.data.server_errors}", "max_count": 0}
    },
    {
      "id": "check_list_p95",
      "type": "check",
      "check_id": "check_load_percentile_ms",
      "label": "投资列表p95<=2000ms",
      "params": {"percentile_ms": "${load_loan_list.data.p95_ms}", "percentile": "p95", "max_ms": 2000}
    },
    {
      "id": "check_list_rps",
      "type": "check",
      "check_id": "check_load_rps",
      "label": "投资列表RPS>=5",
      "params": {"rps": "${load_loan_list.data.rps}", "min_rps": 5}
    },
    {
      "id": "load_loan_total",
      "type": "step",
      "step_id": "step_load_http",
      "label": "压测平台统计 POST loantotal",
      "params": {
        "path": "/common/loan/loantotal", "method": "POST", "site": "front",
        "data": {}, "concurrency": 5, "total_requests": 30
      }
    },
    {
      "id": "check_total_completed",
      "type": "check",
      "check_id": "check_load_all_completed",
      "label": "平台统计请求全部完成",
      "params": {"total_requests": "${load_loan_total.data.total_requests}", "completed": "${load_loan_total.data.completed}"}
    },
    {
      "id": "check_total_rate",
      "type": "check",
      "check_id": "check_load_success_rate",
      "label": "平台统计成功率>=95%",
      "params": {"success_rate": "${load_loan_total.data.success_rate}", "min_rate": 0.95}
    },
    {
      "id": "check_total_5xx",
      "type": "check",
      "check_id": "check_load_no_server_error",
      "label": "平台统计无5xx",
      "params": {"server_errors": "${load_loan_total.data.server_errors}", "max_count": 0}
    },
    {
      "id": "check_total_p95",
      "type": "check",
      "check_id": "check_load_percentile_ms",
      "label": "平台统计p95<=2000ms",
      "params": {"percentile_ms": "${load_loan_total.data.p95_ms}", "percentile": "p95", "max_ms": 2000}
    },
    {
      "id": "check_total_biz",
      "type": "check",
      "check_id": "check_load_business_success_rate",
      "label": "平台统计业务码200占比100%",
      "params": {
        "business_total": "${load_loan_total.data.business_total}",
        "business_ok": "${load_loan_total.data.business_ok}",
        "min_rate": 1.0
      }
    }
  ],
  "edges": [
    {"source": "load_home", "target": "check_home_completed", "condition": "pass"},
    {"source": "check_home_completed", "target": "check_home_rate", "condition": "pass"},
    {"source": "check_home_rate", "target": "check_home_5xx", "condition": "pass"},
    {"source": "check_home_5xx", "target": "check_home_p95", "condition": "pass"},
    {"source": "check_home_p95", "target": "check_home_rps", "condition": "pass"},
    {"source": "check_home_rps", "target": "load_loan_list", "condition": "pass"},
    {"source": "load_loan_list", "target": "check_list_completed", "condition": "pass"},
    {"source": "check_list_completed", "target": "check_list_rate", "condition": "pass"},
    {"source": "check_list_rate", "target": "check_list_5xx", "condition": "pass"},
    {"source": "check_list_5xx", "target": "check_list_p95", "condition": "pass"},
    {"source": "check_list_p95", "target": "check_list_rps", "condition": "pass"},
    {"source": "check_list_rps", "target": "load_loan_total", "condition": "pass"},
    {"source": "load_loan_total", "target": "check_total_completed", "condition": "pass"},
    {"source": "check_total_completed", "target": "check_total_rate", "condition": "pass"},
    {"source": "check_total_rate", "target": "check_total_5xx", "condition": "pass"},
    {"source": "check_total_5xx", "target": "check_total_p95", "condition": "pass"},
    {"source": "check_total_p95", "target": "check_total_biz", "condition": "pass"}
  ],
  "metadata": {"layer": "performance", "mode": "http-only", "read_only": true}
}
