{
  "id": "api/login_validation",
  "name": "API_LOGIN_VAL_001",
  "display_name": "会员登录接口参数校验（空参/用户不存在/错误密码/恢复正常登录）",
  "description": "POST /member/public/login 负向与回归：空表单业务码 100；不存在用户返回“用户不存在”；错误密码返回“密码错误”（仅验证 1 次，站点连续 3 次错误会锁定账户）；末尾正确登录一次确认服务恢复正常并清零错误计数。",
  "category": "api",
  "module": "account",
  "priority": "P1",
  "expected": "三个负向场景业务码均为 100 且消息匹配；最终正确登录业务码 200",
  "nodes": [
    {
      "id": "login_empty",
      "type": "step",
      "step_id": "step_account_login",
      "label": "空表单登录",
      "params": {"keywords": "", "password": ""}
    },
    {
      "id": "check_empty_code",
      "type": "check",
      "check_id": "check_account_business_code",
      "label": "空表单业务码 100",
      "params": {"code": "${login_empty.data.code}", "expected": 100}
    },
    {
      "id": "login_no_user",
      "type": "step",
      "step_id": "step_account_login",
      "label": "不存在用户登录",
      "params": {"keywords": "19900000000", "password": "Aa123456"}
    },
    {
      "id": "check_no_user_code",
      "type": "check",
      "check_id": "check_account_business_code",
      "label": "用户不存在业务码 100",
      "params": {"code": "${login_no_user.data.code}", "expected": 100}
    },
    {
      "id": "check_no_user_msg",
      "type": "check",
      "check_id": "check_account_message_contains",
      "label": "提示用户不存在",
      "params": {"message": "${login_no_user.data.message}", "expected": "用户不存在"}
    },
    {
      "id": "login_bad_pwd",
      "type": "step",
      "step_id": "step_account_login",
      "label": "错误密码登录（仅此 1 次）",
      "params": {"keywords": "18800002008", "password": "wrong_pwd_9"}
    },
    {
      "id": "check_bad_pwd_code",
      "type": "check",
      "check_id": "check_account_business_code",
      "label": "错误密码业务码 100",
      "params": {"code": "${login_bad_pwd.data.code}", "expected": 100}
    },
    {
      "id": "check_bad_pwd_msg",
      "type": "check",
      "check_id": "check_account_message_contains",
      "label": "提示密码错误",
      "params": {"message": "${login_bad_pwd.data.message}", "expected": "密码错误"}
    },
    {
      "id": "login_ok",
      "type": "step",
      "step_id": "step_account_login",
      "label": "正确登录恢复",
      "params": {"keywords": "18800002008", "password": "Aa123456"}
    },
    {
      "id": "check_ok_code",
      "type": "check",
      "check_id": "check_account_business_code",
      "label": "恢复登录业务码 200",
      "params": {"code": "${login_ok.data.code}", "expected": 200}
    }
  ],
  "edges": [
    {"source": "login_empty", "target": "check_empty_code", "condition": "pass"},
    {"source": "check_empty_code", "target": "login_no_user", "condition": "pass"},
    {"source": "login_no_user", "target": "check_no_user_code", "condition": "pass"},
    {"source": "check_no_user_code", "target": "check_no_user_msg", "condition": "pass"},
    {"source": "check_no_user_msg", "target": "login_bad_pwd", "condition": "pass"},
    {"source": "login_bad_pwd", "target": "check_bad_pwd_code", "condition": "pass"},
    {"source": "check_bad_pwd_code", "target": "check_bad_pwd_msg", "condition": "pass"},
    {"source": "check_bad_pwd_msg", "target": "login_ok", "condition": "pass"},
    {"source": "login_ok", "target": "check_ok_code", "condition": "pass"}
  ],
  "metadata": {"layer": "api-negative", "write_side_effect": "none", "lockout_note": "错误密码仅断言 1 次，末步正确登录清零计数"}
}
