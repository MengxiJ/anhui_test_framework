{
  "id": "borrow/repay_plan",
  "name": "BORROW_REPAY_PLAN_001",
  "display_name": "借款管理：我的还款计划页面校验",
  "description": "切换至借款账户，进入「借款管理 → 我的还款计划」，校验还款计划表头含标题/应收日期/应收本金/应收利息等核心列，页面正常渲染。",
  "category": "borrow",
  "module": "repay",
  "priority": "P1",
  "precondition": "1. 会员 18800002008 可登录",
  "expected": "还款计划页表格表头含日期/本金/利息/总额等列",
  "nodes": [
    {
      "id": "step_open_login_page",
      "type": "step",
      "step_id": "step_open_member_login_page",
      "label": "打开前台登录页"
    },
    {
      "id": "step_member_login",
      "type": "step",
      "step_id": "step_member_login",
      "label": "会员登录",
      "params": {"phone": "18800002008", "password": "Aa123456"}
    },
    {
      "id": "step_wait_center",
      "type": "step",
      "step_id": "step_wait_for_url",
      "label": "等待进入会员中心",
      "params": {"fragment": "member/member/center"}
    },
    {
      "id": "step_open_repay",
      "type": "step",
      "step_id": "step_open_url_settled",
      "label": "打开我的还款计划页",
      "params": {"url": "/loan/repay/index"}
    },
    {
      "id": "step_read_repay_text",
      "type": "step",
      "step_id": "step_get_element_text",
      "label": "读取还款计划页文本",
      "params": {"by": "css", "value": "body"}
    },
    {
      "id": "check_repay_loaded",
      "type": "check",
      "check_id": "check_text_contains",
      "label": "校验还款计划页含「还款」",
      "params": {"actual": "${step_read_repay_text.data.text}", "expected": "还款"}
    },
    {
      "id": "step_read_repay_table",
      "type": "step",
      "step_id": "step_get_table_data",
      "label": "读取还款计划表格",
      "params": {"by": "css", "value": "table"}
    },
    {
      "id": "check_repay_table",
      "type": "check",
      "check_id": "check_value_greater_than",
      "label": "校验还款计划表格可读取",
      "params": {"actual": "${step_read_repay_table.data.row_count}", "expected": -1}
    }
  ],
  "edges": [
    {"source": "step_open_login_page", "target": "step_member_login", "condition": "pass"},
    {"source": "step_member_login", "target": "step_wait_center", "condition": "pass"},
    {"source": "step_wait_center", "target": "step_open_repay", "condition": "pass"},
    {"source": "step_open_repay", "target": "step_read_repay_text", "condition": "pass"},
    {"source": "step_read_repay_text", "target": "check_repay_loaded", "condition": "pass"},
    {"source": "check_repay_loaded", "target": "step_read_repay_table", "condition": "pass"},
    {"source": "step_read_repay_table", "target": "check_repay_table", "condition": "pass"}
  ],
  "metadata": {"layer": "ui-data", "write_side_effect": "none", "note": "校验我的还款计划页加载与表格结构"}
}
