{
  "id": "borrow/my_loan_list",
  "name": "BORROW_MYLOAN_001",
  "display_name": "借款管理：我的借款列表状态分类校验",
  "description": "切换至借款账户，进入「借款管理 → 我的借款」，校验借款列表按状态分类（待审核/借款中/还款中/已还完/已流标），表格展示借款金额、状态等核心字段。",
  "category": "borrow",
  "module": "myloan",
  "priority": "P1",
  "precondition": "1. 会员 18800002008 可登录",
  "expected": "我的借款页含状态分类 tab，表格表头含借款金额/状态等列",
  "nodes": [
    {
      "id": "step_open_login_page",
      "type": "step",
      "step_id": "step_open_member_login_page",
      "label": "打开前台登录页"
    },
    {
      "id": "step_member_login",
      "type": "step",
      "step_id": "step_member_login",
      "label": "会员登录",
      "params": {"phone": "18800002008", "password": "Aa123456"}
    },
    {
      "id": "step_wait_center",
      "type": "step",
      "step_id": "step_wait_for_url",
      "label": "等待进入会员中心",
      "params": {"fragment": "member/member/center"}
    },
    {
      "id": "step_open_myloan",
      "type": "step",
      "step_id": "step_open_url_settled",
      "label": "打开我的借款页",
      "params": {"url": "/loan/loan/myloan"}
    },
    {
      "id": "step_read_myloan_text",
      "type": "step",
      "step_id": "step_get_element_text",
      "label": "读取我的借款页文本",
      "params": {"by": "css", "value": "body"}
    },
    {
      "id": "check_myloan_loaded",
      "type": "check",
      "check_id": "check_text_contains",
      "label": "校验含「借款」关键字",
      "params": {"actual": "${step_read_myloan_text.data.text}", "expected": "借款"}
    },
    {
      "id": "step_read_myloan_table",
      "type": "step",
      "step_id": "step_get_table_data",
      "label": "读取借款列表表格",
      "params": {"by": "css", "value": "table"}
    },
    {
      "id": "check_myloan_table",
      "type": "check",
      "check_id": "check_value_greater_than",
      "label": "校验借款表格可读取（行数 ≥ 0）",
      "params": {"actual": "${step_read_myloan_table.data.row_count}", "expected": -1}
    }
  ],
  "edges": [
    {"source": "step_open_login_page", "target": "step_member_login", "condition": "pass"},
    {"source": "step_member_login", "target": "step_wait_center", "condition": "pass"},
    {"source": "step_wait_center", "target": "step_open_myloan", "condition": "pass"},
    {"source": "step_open_myloan", "target": "step_read_myloan_text", "condition": "pass"},
    {"source": "step_read_myloan_text", "target": "check_myloan_loaded", "condition": "pass"},
    {"source": "check_myloan_loaded", "target": "step_read_myloan_table", "condition": "pass"},
    {"source": "step_read_myloan_table", "target": "check_myloan_table", "condition": "pass"}
  ],
  "metadata": {"layer": "ui-data", "write_side_effect": "none", "note": "校验我的借款列表页加载与表格结构"}
}
