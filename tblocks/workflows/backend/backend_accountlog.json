{
  "id": "backend/accountlog",
  "name": "BACKEND_ACCOUNTLOG_001",
  "display_name": "后端：收支记录 - 网站收支与用户收支列表校验",
  "description": "管理员登录后台，依次进入「资金管理 → 收支记录 → 网站收支」和「用户收支」，校验两个收支列表 iframe 加载正确、表头含收入/支出/余额等列。",
  "category": "backend",
  "module": "accountlog",
  "priority": "P1",
  "precondition": "1. 管理员 admin 可登录后台",
  "expected": "网站收支与用户收支列表 iframe 均加载正确，表头含金额/时间列",
  "nodes": [
    {
      "id": "step_open_backend_login",
      "type": "step",
      "step_id": "step_open_backend_login_page",
      "label": "打开后台登录页"
    },
    {
      "id": "step_backend_login",
      "type": "step",
      "step_id": "step_backend_login",
      "label": "管理员登录后台",
      "params": {
        "username": "${custom_params.admin_username}",
        "password": "${custom_params.admin_password}",
        "img_code": "${custom_params.img_code}"
      }
    },
    {
      "id": "step_open_web_accountlog",
      "type": "step",
      "step_id": "step_open_backend_loan_menu",
      "label": "进入网站收支列表",
      "params": {"top_menu": "资金管理", "group": "收支记录", "item_rel": "finance/accountlog/web"}
    },
    {
      "id": "check_web_src",
      "type": "check",
      "check_id": "check_text_contains",
      "label": "校验网站收支路由加载",
      "params": {"actual": "${step_open_web_accountlog.data.src}", "expected": "accountlog/web"}
    },
    {
      "id": "step_get_web_info",
      "type": "step",
      "step_id": "step_get_backend_loan_list_info",
      "label": "读取网站收支列表信息"
    },
    {
      "id": "check_web_headers",
      "type": "check",
      "check_id": "check_text_contains",
      "label": "校验网站收支表头含金额",
      "params": {"actual": "${step_get_web_info.data.headers_text}", "expected": "金额"}
    },
    {
      "id": "step_open_member_accountlog",
      "type": "step",
      "step_id": "step_open_backend_loan_menu",
      "label": "进入用户收支列表",
      "params": {"top_menu": "资金管理", "group": "收支记录", "item_rel": "finance/accountlog/member"}
    },
    {
      "id": "check_member_src",
      "type": "check",
      "check_id": "check_text_contains",
      "label": "校验用户收支路由加载",
      "params": {"actual": "${step_open_member_accountlog.data.src}", "expected": "accountlog/member"}
    },
    {
      "id": "step_get_member_info",
      "type": "step",
      "step_id": "step_get_backend_loan_list_info",
      "label": "读取用户收支列表信息"
    },
    {
      "id": "check_member_headers",
      "type": "check",
      "check_id": "check_text_contains",
      "label": "校验用户收支表头含金额",
      "params": {"actual": "${step_get_member_info.data.headers_text}", "expected": "金额"}
    }
  ],
  "edges": [
    {"source": "step_open_backend_login", "target": "step_backend_login", "condition": "pass"},
    {"source": "step_backend_login", "target": "step_open_web_accountlog", "condition": "pass"},
    {"source": "step_open_web_accountlog", "target": "check_web_src", "condition": "pass"},
    {"source": "check_web_src", "target": "step_get_web_info", "condition": "pass"},
    {"source": "step_get_web_info", "target": "check_web_headers", "condition": "pass"},
    {"source": "check_web_headers", "target": "step_open_member_accountlog", "condition": "pass"},
    {"source": "step_open_member_accountlog", "target": "check_member_src", "condition": "pass"},
    {"source": "check_member_src", "target": "step_get_member_info", "condition": "pass"},
    {"source": "step_get_member_info", "target": "check_member_headers", "condition": "pass"}
  ],
  "metadata": {"teardown_hooks": [{"step_id": "step_capture_screenshot", "params": {"file_name": "backend_accountlog_teardown"}}]}
}
