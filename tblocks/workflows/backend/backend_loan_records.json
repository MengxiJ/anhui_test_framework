{
  "id": "backend/loan_records",
  "name": "BACKEND_LOAN_RECORDS_001",
  "display_name": "后端：借贷记录 - 还款/收款/投资信息列表校验",
  "description": "管理员登录后台，依次进入「借款管理 → 借贷记录 → 还款信息」「收款信息」「投资信息」三个子页面，校验各列表 iframe 加载正确、表头渲染完整。",
  "category": "backend",
  "module": "loan_records",
  "priority": "P1",
  "precondition": "1. 管理员 admin 可登录后台",
  "expected": "还款/收款/投资信息三个列表 iframe 均加载正确，表头渲染正常",
  "nodes": [
    {
      "id": "step_open_backend_login",
      "type": "step",
      "step_id": "step_open_backend_login_page",
      "label": "打开后台登录页"
    },
    {
      "id": "step_backend_login",
      "type": "step",
      "step_id": "step_backend_login",
      "label": "管理员登录后台",
      "params": {
        "username": "${custom_params.admin_username}",
        "password": "${custom_params.admin_password}",
        "img_code": "${custom_params.img_code}"
      }
    },
    {
      "id": "step_open_repay_info",
      "type": "step",
      "step_id": "step_open_backend_loan_menu",
      "label": "进入还款信息列表",
      "params": {"top_menu": "借款管理", "group": "借贷记录", "item_rel": "loan/repayperiod/list"}
    },
    {
      "id": "check_repay_src",
      "type": "check",
      "check_id": "check_text_contains",
      "label": "校验还款信息路由加载",
      "params": {"actual": "${step_open_repay_info.data.src}", "expected": "repayperiod/list"}
    },
    {
      "id": "step_get_repay_info",
      "type": "step",
      "step_id": "step_get_backend_loan_list_info",
      "label": "读取还款信息列表"
    },
    {
      "id": "check_repay_headers",
      "type": "check",
      "check_id": "check_text_contains",
      "label": "校验还款信息表头渲染",
      "params": {"actual": "${step_get_repay_info.data.headers_text}", "expected": "金额"}
    },
    {
      "id": "step_open_recover_info",
      "type": "step",
      "step_id": "step_open_backend_loan_menu",
      "label": "进入收款信息列表",
      "params": {"top_menu": "借款管理", "group": "借贷记录", "item_rel": "loan/recover/list"}
    },
    {
      "id": "check_recover_src",
      "type": "check",
      "check_id": "check_text_contains",
      "label": "校验收款信息路由加载",
      "params": {"actual": "${step_open_recover_info.data.src}", "expected": "recover/list"}
    },
    {
      "id": "step_get_recover_info",
      "type": "step",
      "step_id": "step_get_backend_loan_list_info",
      "label": "读取收款信息列表"
    },
    {
      "id": "step_open_tender_info",
      "type": "step",
      "step_id": "step_open_backend_loan_menu",
      "label": "进入投资信息列表",
      "params": {"top_menu": "借款管理", "group": "借贷记录", "item_rel": "loan/tender/list"}
    },
    {
      "id": "check_tender_src",
      "type": "check",
      "check_id": "check_text_contains",
      "label": "校验投资信息路由加载",
      "params": {"actual": "${step_open_tender_info.data.src}", "expected": "tender/list"}
    }
  ],
  "edges": [
    {"source": "step_open_backend_login", "target": "step_backend_login", "condition": "pass"},
    {"source": "step_backend_login", "target": "step_open_repay_info", "condition": "pass"},
    {"source": "step_open_repay_info", "target": "check_repay_src", "condition": "pass"},
    {"source": "check_repay_src", "target": "step_get_repay_info", "condition": "pass"},
    {"source": "step_get_repay_info", "target": "check_repay_headers", "condition": "pass"},
    {"source": "check_repay_headers", "target": "step_open_recover_info", "condition": "pass"},
    {"source": "step_open_recover_info", "target": "check_recover_src", "condition": "pass"},
    {"source": "check_recover_src", "target": "step_get_recover_info", "condition": "pass"},
    {"source": "step_get_recover_info", "target": "step_open_tender_info", "condition": "pass"},
    {"source": "step_open_tender_info", "target": "check_tender_src", "condition": "pass"}
  ],
  "metadata": {"teardown_hooks": [{"step_id": "step_capture_screenshot", "params": {"file_name": "backend_loan_records_teardown"}}]}
}
