    },
    {
      "id": "check_accountlog_rows",
      "type": "check",
      "check_id": "check_value_greater_than",
      "label": "校验会员收支记录队列有数据",
      "params": {"actual": "${step_get_accountlog_info.data.row_count}", "expected": 0}
    },
    {
      "id": "step_open_bounty_list",
      "type": "step",
      "step_id": "step_open_backend_loan_menu",
      "label": "进入 红包列表",
      "params": {"top_menu": "资金管理", "group": "红包管理", "item_rel": "finance/bounty/list"}
    },
    {
      "id": "check_bounty_src",
      "type": "check",
      "check_id": "check_text_contains",
      "label": "校验红包列表路由加载",
      "params": {"actual": "${step_open_bounty_list.data.src}", "expected": "finance/bounty/list"}
    },
    {
      "id": "step_get_bounty_info",
      "type": "step",
      "step_id": "step_get_backend_loan_list_info",
      "label": "读取红包列表信息"
    },
    {
      "id": "check_bounty_headers",
      "type": "check",
      "check_id": "check_text_contains",
      "label": "校验红包表头渲染",
      "params": {"actual": "${step_get_bounty_info.data.headers_text}", "expected": "红包"}
    },
    {
      "id": "step_open_new_rewards",
      "type": "step",
      "step_id": "step_open_backend_loan_menu",
      "label": "进入 活动结算",
      "params": {"top_menu": "资金管理", "group": "活动结算", "item_rel": "loan/newRewards/list"}
    },
    {
      "id": "check_new_rewards_src",
      "type": "check",
      "check_id": "check_text_contains",
      "label": "校验活动结算路由加载",
      "params": {"actual": "${step_open_new_rewards.data.src}", "expected": "loan/newRewards/list"}
    }
  ],
